/* =========================================================
DR. MUHAMMAD FAHREZA
MAIN WEBSITE STYLESHEET
========================================================= */

/* =========================
RESET
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

html {
scroll-behavior: smooth;
}

body {
font-family: "Inter", sans-serif;
color: #172033;
background: #ffffff;
line-height: 1.7;
}

img {
max-width: 100%;
display: block;
}

a {
color: inherit;
text-decoration: none;
}

button {
font-family: inherit;
}

/* =========================
VARIABLES
========================= */

:root {

```
--primary: #0f766e;
--primary-dark: #115e59;
--primary-light: #ccfbf1;

--accent: #14b8a6;

--dark: #172033;
--text: #475569;
--muted: #64748b;

--light: #f8fafc;
--border: #e2e8f0;

--white: #ffffff;

--shadow-sm:
    0 4px 15px rgba(15, 23, 42, 0.06);

--shadow-md:
    0 12px 30px rgba(15, 23, 42, 0.09);

--shadow-lg:
    0 20px 50px rgba(15, 23, 42, 0.12);

--radius-sm: 10px;
--radius-md: 18px;
--radius-lg: 28px;
```

}

/* =========================
CONTAINER
========================= */

.container {
width: min(1180px, calc(100% - 40px));
margin: 0 auto;
}

/* =========================
NAVBAR
========================= */

.navbar {
position: sticky;
top: 0;
z-index: 1000;

```
background: rgba(255, 255, 255, 0.94);

backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

border-bottom: 1px solid rgba(226, 232, 240, 0.8);
```

}

.nav-container {

```
min-height: 76px;

display: flex;
align-items: center;
justify-content: space-between;
```

}

/* LOGO */

.logo {
display: flex;
align-items: center;
gap: 11px;
}

.logo-icon {

```
width: 42px;
height: 42px;

display: grid;
place-items: center;

border-radius: 12px;

background: var(--primary);
color: white;

font-family: "Manrope", sans-serif;
font-size: 14px;
font-weight: 800;
```

}

.logo-text {

```
display: flex;
flex-direction: column;

line-height: 1.15;
```

}

.logo-text strong {

```
font-family: "Manrope", sans-serif;

font-size: 16px;
color: var(--dark);
```

}

.logo-text small {

```
margin-top: 3px;

font-size: 10px;

color: var(--muted);

letter-spacing: 0.3px;
```

}

/* NAVIGATION */

.nav-menu {

```
display: flex;
align-items: center;

gap: 30px;
```

}

.nav-menu a {

```
position: relative;

color: #475569;

font-size: 14px;
font-weight: 600;

transition: 0.25s ease;
```

}

.nav-menu a:hover,
.nav-menu a.active {

```
color: var(--primary);
```

}

.nav-menu a.active::after {

```
content: "";

position: absolute;

left: 0;
right: 0;

bottom: -27px;

height: 2px;

background: var(--primary);

border-radius: 10px;
```

}

/* MOBILE MENU */

.menu-toggle {

```
display: none;

border: 0;

background: transparent;

font-size: 26px;

cursor: pointer;

color: var(--dark);
```

}

/* =========================
HERO
========================= */

.hero {

```
position: relative;

overflow: hidden;

padding: 90px 0 100px;

background:
    linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
    );
```

}

.hero-container {

```
min-height: 570px;

display: grid;

grid-template-columns:
    minmax(0, 1.05fr)
    minmax(350px, 0.95fr);

align-items: center;

gap: 80px;
```

}

/* HERO CONTENT */

.eyebrow {

```
display: inline-flex;

align-items: center;

padding: 7px 13px;

border-radius: 999px;

background: var(--primary-light);

color: var(--primary-dark);

font-size: 13px;

font-weight: 700;

margin-bottom: 18px;
```

}

.hero h1 {

```
font-family: "Manrope", sans-serif;

font-size: clamp(42px, 5vw, 70px);

line-height: 1.05;

letter-spacing: -2.5px;

color: var(--dark);

margin-bottom: 16px;
```

}

.hero h1 span {

```
display: block;

color: var(--primary);
```

}

.hero h2 {

```
font-size: 19px;

color: var(--primary-dark);

font-weight: 700;

margin-bottom: 20px;
```

}

.hero-content > p {

```
max-width: 650px;

color: var(--text);

font-size: 16px;

margin-bottom: 13px;
```

}

.hero-content strong {

```
color: var(--dark);
```

}

/* BUTTONS */

.hero-buttons {

```
display: flex;

flex-wrap: wrap;

gap: 12px;

margin-top: 28px;
```

}

.btn {

```
display: inline-flex;

align-items: center;
justify-content: center;

min-height: 48px;

padding: 0 22px;

border-radius: 12px;

font-size: 14px;

font-weight: 700;

transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
```

}

.btn:hover {

```
transform: translateY(-2px);
```

}

.btn-primary {

```
background: var(--primary);

color: white;

box-shadow:
    0 8px 20px rgba(15, 118, 110, 0.22);
```

}

.btn-primary:hover {

```
background: var(--primary-dark);

box-shadow:
    0 12px 25px rgba(15, 118, 110, 0.27);
```

}

.btn-secondary {

```
background: white;

color: var(--dark);

border: 1px solid var(--border);
```

}

.btn-secondary:hover {

```
border-color: var(--primary);

color: var(--primary);
```

}

.btn-light {

```
background: white;

color: var(--primary);

box-shadow: var(--shadow-sm);
```

}

/* FOCUS TAGS */

.focus-tags {

```
display: flex;

flex-wrap: wrap;

gap: 8px;

margin-top: 28px;
```

}

.focus-tags span {

```
padding: 7px 11px;

border-radius: 999px;

background: white;

border: 1px solid var(--border);

color: var(--muted);

font-size: 12px;

font-weight: 600;
```

}

/* HERO IMAGE */

.hero-image-wrapper {

```
position: relative;

min-height: 520px;

display: flex;

align-items: center;

justify-content: center;
```

}

.hero-image {

```
position: relative;

width: min(390px, 85%);

aspect-ratio: 0.82;

overflow: hidden;

border-radius: 190px 190px 35px 35px;

background: #dff7f3;

border: 10px solid white;

box-shadow: var(--shadow-lg);

z-index: 2;
```

}

.hero-image img {

```
width: 100%;
height: 100%;

object-fit: cover;

object-position: center;
```

}

/* DECORATION */

.hero-decoration {

```
position: absolute;

border-radius: 50%;

z-index: 1;
```

}

.decoration-one {

```
width: 320px;
height: 320px;

background: #ccfbf1;

top: 20px;
right: 0;
```

}

.decoration-two {

```
width: 150px;
height: 150px;

background: #e0f2fe;

bottom: 20px;
left: 10px;
```

}

/* DOCTOR BADGE */

.doctor-badge {

```
position: absolute;

right: 0;
bottom: 55px;

z-index: 5;

display: flex;

align-items: center;

gap: 10px;

padding: 13px 16px;

background: white;

border-radius: 15px;

box-shadow: var(--shadow-md);
```

}

.badge-icon {

```
width: 35px;
height: 35px;

display: grid;
place-items: center;

border-radius: 50%;

background: var(--primary-light);

color: var(--primary);

font-weight: 800;
```

}

.doctor-badge div:last-child {

```
display: flex;

flex-direction: column;

line-height: 1.25;
```

}

.doctor-badge strong {

```
font-size: 12px;

color: var(--dark);
```

}

.doctor-badge small {

```
font-size: 10px;

color: var(--muted);
```

}

/* =========================
QUICK INFO
========================= */

.quick-info {

```
position: relative;

margin-top: -35px;

z-index: 10;
```

}

.quick-info-grid {

```
display: grid;

grid-template-columns:
    repeat(3, 1fr);

background: white;

border-radius: 18px;

box-shadow: var(--shadow-md);

border: 1px solid var(--border);

overflow: hidden;
```

}

.info-card {

```
display: flex;

align-items: center;

gap: 14px;

padding: 25px 28px;

border-right: 1px solid var(--border);
```

}

.info-card:last-child {

```
border-right: 0;
```

}

.info-icon {

```
width: 45px;
height: 45px;

display: grid;
place-items: center;

flex-shrink: 0;

border-radius: 13px;

background: var(--primary-light);

font-size: 20px;
```

}

.info-card div:last-child {

```
display: flex;

flex-direction: column;

line-height: 1.35;
```

}

.info-card strong {

```
color: var(--dark);

font-size: 13px;
```

}

.info-card span {

```
color: var(--muted);

font-size: 11px;

margin-top: 4px;
```

}

/* =========================
GENERAL SECTION
========================= */

.section {

```
padding: 100px 0;
```

}

.section-heading {

```
max-width: 700px;

margin-bottom: 45px;
```

}

.section-label {

```
display: inline-block;

color: var(--primary);

font-size: 11px;

font-weight: 800;

letter-spacing: 1.8px;

margin-bottom: 10px;
```

}

.section-heading h2 {

```
font-family: "Manrope", sans-serif;

font-size: clamp(30px, 4vw, 43px);

line-height: 1.15;

letter-spacing: -1.2px;

color: var(--dark);

margin-bottom: 15px;
```

}

.section-heading p {

```
color: var(--text);

font-size: 15px;
```

}

/* =========================
TOOLS
========================= */

.tools-section {

```
background: white;
```

}

.tools-grid {

```
display: grid;

grid-template-columns:
    repeat(3, 1fr);

gap: 20px;
```

}

.tool-card {

```
display: flex;

gap: 18px;

padding: 28px;

border: 1px solid var(--border);

border-radius: var(--radius-md);

background: white;

box-shadow: var(--shadow-sm);

transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
```

}

.tool-card:hover {

```
transform: translateY(-5px);

border-color: #99f6e4;

box-shadow: var(--shadow-md);
```

}

.tool-icon {

```
width: 52px;
height: 52px;

display: grid;
place-items: center;

flex-shrink: 0;

border-radius: 15px;

background: var(--primary-light);

font-size: 23px;
```

}

.tool-card h3 {

```
font-family: "Manrope", sans-serif;

color: var(--dark);

font-size: 17px;

margin-bottom: 8px;
```

}

.tool-card p {

```
color: var(--muted);

font-size: 13px;

line-height: 1.6;

margin-bottom: 15px;
```

}

.tool-link {

```
color: var(--primary);

font-size: 12px;

font-weight: 800;
```

}

/* =========================
GOAL
========================= */

.goal-section {

```
background: #f8fafc;
```

}

.goal-grid {

```
display: grid;

grid-template-columns:
    repeat(3, 1fr);

gap: 20px;
```

}

.goal-card {

```
position: relative;

overflow: hidden;

padding: 35px;

border-radius: var(--radius-md);

background: white;

border: 1px solid var(--border);

box-shadow: var(--shadow-sm);

transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
```

}

.goal-card:hover {

```
transform: translateY(-5px);

box-shadow: var(--shadow-md);
```

}

.goal-icon {

```
font-size: 34px;

margin-bottom: 18px;
```

}

.goal-card h3 {

```
font-family: "Manrope", sans-serif;

font-size: 21px;

color: var(--dark);

margin-bottom: 9px;
```

}

.goal-card p {

```
color: var(--muted);

font-size: 13px;

margin-bottom: 18px;
```

}

.goal-card > span {

```
color: var(--primary);

font-size: 12px;

font-weight: 800;
```

}

/* =========================
ABOUT
========================= */

.about-section {

```
background: white;
```

}

.about-container {

```
display: grid;

grid-template-columns:
    0.8fr 1.2fr;

gap: 80px;

align-items: center;
```

}

.about-image {

```
width: 100%;

max-width: 400px;

margin: 0 auto;

border-radius: 30px;

overflow: hidden;

box-shadow: var(--shadow-lg);
```

}

.about-image img {

```
width: 100%;

aspect-ratio: 0.85;

object-fit: cover;
```

}

.about-content h2 {

```
font-family: "Manrope", sans-serif;

font-size: clamp(28px, 3.5vw, 40px);

line-height: 1.2;

letter-spacing: -1px;

color: var(--dark);

margin-bottom: 25px;
```

}

.about-content p {

```
color: var(--text);

font-size: 14px;

margin-bottom: 14px;
```

}

.about-focus {

```
display: flex;

flex-wrap: wrap;

gap: 8px;

margin-top: 25px;
```

}

.about-focus span {

```
padding: 8px 12px;

border-radius: 999px;

background: var(--light);

border: 1px solid var(--border);

color: var(--text);

font-size: 11px;

font-weight: 700;
```

}

/* =========================
EDUCATION
========================= */

.education-section {

```
background: #f8fafc;
```

}

.article-placeholder {

```
text-align: center;

padding: 60px 30px;

border-radius: var(--radius-lg);

border: 1px dashed #cbd5e1;

background: white;
```

}

.placeholder-icon {

```
font-size: 45px;

margin-bottom: 15px;
```

}

.article-placeholder h3 {

```
font-family: "Manrope", sans-serif;

color: var(--dark);

font-size: 21px;

margin-bottom: 10px;
```

}

.article-placeholder p {

```
max-width: 600px;

margin: 0 auto 22px;

color: var(--muted);

font-size: 14px;
```

}

/* =========================
CTA
========================= */

.cta-section {

```
padding: 70px 0;

background:
    linear-gradient(
        135deg,
        var(--primary),
        var(--primary-dark)
    );

color: white;
```

}

.cta-container {

```
display: flex;

align-items: center;

justify-content: space-between;

gap: 30px;
```

}

.cta-section .section-label {

```
color: #99f6e4;
```

}

.cta-section h2 {

```
font-family: "Manrope", sans-serif;

font-size: clamp(28px, 4vw, 42px);

line-height: 1.15;

margin-bottom: 12px;
```

}

.cta-section p {

```
max-width: 650px;

color: #ccfbf1;

font-size: 14px;
```

}

/* =========================
FOOTER
========================= */

.footer {

```
background: #0f172a;

color: white;

padding-top: 65px;
```

}

.footer-container {

```
display: grid;

grid-template-columns:
    1.5fr 0.7fr 0.7fr;

gap: 70px;

padding-bottom: 55px;
```

}

.footer-logo .logo-text strong {

```
color: white;
```

}

.footer-logo .logo-text small {

```
color: #94a3b8;
```

}

.footer-brand p {

```
max-width: 450px;

margin-top: 20px;

color: #94a3b8;

font-size: 13px;
```

}

.footer-links {

```
display: flex;

flex-direction: column;

gap: 10px;
```

}

.footer-links h4 {

```
font-size: 13px;

margin-bottom: 8px;
```

}

.footer-links a {

```
color: #94a3b8;

font-size: 12px;

transition: color 0.2s ease;
```

}

.footer-links a:hover {

```
color: white;
```

}

.footer-bottom {

```
border-top: 1px solid rgba(255, 255, 255, 0.08);

padding: 22px 0;
```

}

.footer-bottom .container {

```
display: flex;

justify-content: space-between;

gap: 20px;
```

}

.footer-bottom p {

```
color: #64748b;

font-size: 10px;
```

}

.footer-bottom .disclaimer {

```
max-width: 500px;

text-align: right;
```

}

/* =========================
RESPONSIVE
========================= */

@media (max-width: 1000px) {

```
.hero-container {

    grid-template-columns: 1fr;

    text-align: center;

    gap: 50px;
}

.hero-content {

    max-width: 750px;

    margin: 0 auto;
}

.hero-content > p {

    margin-left: auto;
    margin-right: auto;
}

.hero-buttons {

    justify-content: center;
}

.focus-tags {

    justify-content: center;
}

.hero-image-wrapper {

    min-height: 450px;
}

.doctor-badge {

    right: 8%;
}

.tools-grid,
.goal-grid {

    grid-template-columns:
        repeat(2, 1fr);
}

.about-container {

    grid-template-columns: 1fr;

    gap: 50px;

    text-align: center;
}

.about-image {

    max-width: 360px;
}

.about-focus {

    justify-content: center;
}
```

}

@media (max-width: 760px) {

```
.container {

    width: min(100% - 28px, 600px);
}


/* NAV */

.nav-container {

    min-height: 68px;
}

.menu-toggle {

    display: block;
}

.nav-menu {

    position: absolute;

    top: 68px;

    left: 0;
    right: 0;

    display: none;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding: 10px 14px 16px;

    background: white;

    border-bottom: 1px solid var(--border);

    box-shadow: var(--shadow-md);
}

.nav-menu.active {

    display: flex;
}

.nav-menu a {

    padding: 13px 8px;

    border-radius: 8px;
}

.nav-menu a:hover {

    background: var(--light);
}

.nav-menu a.active::after {

    display: none;
}


/* HERO */

.hero {

    padding: 65px 0 75px;
}

.hero h1 {

    font-size: clamp(39px, 12vw, 55px);

    letter-spacing: -1.8px;
}

.hero h2 {

    font-size: 16px;
}

.hero-content > p {

    font-size: 14px;
}

.hero-image-wrapper {

    min-height: 390px;
}

.hero-image {

    width: min(300px, 82%);

    border-width: 7px;
}

.decoration-one {

    width: 230px;
    height: 230px;

    right: 5%;
}

.decoration-two {

    width: 110px;
    height: 110px;

    left: 5%;
}

.doctor-badge {

    right: 2%;

    bottom: 25px;

    padding: 10px 12px;
}


/* QUICK INFO */

.quick-info {

    margin-top: -20px;
}

.quick-info-grid {

    grid-template-columns: 1fr;
}

.info-card {

    border-right: 0;

    border-bottom: 1px solid var(--border);

}

.info-card:last-child {

    border-bottom: 0;
}


/* SECTION */

.section {

    padding: 75px 0;
}

.section-heading {

    margin-bottom: 30px;
}


/* CARDS */

.tools-grid,
.goal-grid {

    grid-template-columns: 1fr;
}

.tool-card {

    padding: 22px;
}

.goal-card {

    padding: 28px;
}


/* CTA */

.cta-container {

    flex-direction: column;

    align-items: flex-start;
}


/* FOOTER */

.footer-container {

    grid-template-columns: 1fr 1fr;

    gap: 40px;
}

.footer-brand {

    grid-column: 1 / -1;
}

.footer-bottom .container {

    flex-direction: column;

    gap: 8px;
}

.footer-bottom .disclaimer {

    text-align: left;
}
```

}

@media (max-width: 450px) {

```
.hero-buttons {

    flex-direction: column;
}

.hero-buttons .btn {

    width: 100%;
}

.hero-image-wrapper {

    min-height: 340px;
}

.hero-image {

    width: 250px;
}

.doctor-badge {

    right: 0;

    transform: scale(0.9);
}

.footer-container {

    grid-template-columns: 1fr;
}
```

}
